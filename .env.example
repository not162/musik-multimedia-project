APP_NAME="Pemutar Musik Interaktif"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_NODE_ID=node-1

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=musikku
DB_USERNAME=root
DB_PASSWORD=
DB_READ_HOST=127.0.0.1

SESSION_DRIVER=file
SESSION_SECURE_COOKIE=false
CACHE_STORE=file
QUEUE_CONNECTION=sync

HASH_DRIVER=bcrypt
BCRYPT_ROUNDS=12

CORS_ALLOWED_ORIGINS=*

RATE_LIMIT_API_PUBLIC=60
RATE_LIMIT_API_AUTH=10
RATE_LIMIT_API_USER=60
RATE_LIMIT_API_ADMIN=120

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,127.0.0.1,127.0.0.1:8000
SANCTUM_TOKEN_EXPIRATION=1440
CDN_ENABLED=false
CDN_URL=

LOG_CHANNEL=stack
LOG_STACK=single,daily
LOG_DAILY_DAYS=14

# Choose 'reverb' for local WebSocket server or 'pusher' for Pusher Channels
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=musikku-app
REVERB_APP_KEY=musikku-local-key
REVERB_APP_SECRET=musikku-local-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8090
REVERB_SCHEME=http
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8090

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=ap1
PUSHER_PORT=443
PUSHER_SCHEME=https
