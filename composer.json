{
    "name": "ubsi/musik-interaktif",
    "type": "project",
    "license": "MIT",
    "description": "Pemutar Musik Interaktif Berbasis Web untuk Mahasiswa (Laravel)",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0",
        "laravel/reverb": "^1.14",
        "laravel/sanctum": "^4.5",
        "laravel/tinker": "^3.2",
        "pusher/pusher-php-server": "^7.3"
    },
    "require-dev": {
        "nunomaduro/collision": "^8.9",
        "phpunit/phpunit": "^13.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
